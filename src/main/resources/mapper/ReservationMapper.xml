<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ReservationMapper">

    <!-- =========================================================
         予約登録
         POST /shops/{shopId}/reservations
         ========================================================= -->
    <insert id="insertReservation"
            parameterType="com.example.demo.entity.Reservations"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO reservations
        (
            member_id,
            reservation_date,
            status,
            created_at,
            store_id,
            number
        )
        VALUES
        (
            #{memberId},
            #{reservationDate},
            #{status},
            #{createdAt},
            #{storeId},
            #{number}
        )

    </insert>


    <!-- =========================================================
         予約IDから1件取得
         GET /reservations/{reservationId}
         ========================================================= -->
    <select id="findById"
            parameterType="java.lang.Integer"
            resultType="com.example.demo.entity.Reservations">

        SELECT
            id,
            member_id,
            reservation_date,
            status,
            created_at,
            store_id,
            number
        FROM reservations
        WHERE id = #{reservationId}

    </select>




</mapper>