<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.TenantMapper">

    <!-- Stores.java とDBカラムの対応 -->
    <resultMap id="storeResultMap"
               type="com.example.demo.entity.Stores">

        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="nameKana" column="name_kana"/>
        <result property="mail" column="mail"/>
        <result property="password" column="password"/>
        <result property="representative" column="representative"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="address" column="address"/>
        <result property="description" column="description"/>
        <result property="pictureUrl" column="picture_url"/>
        <result property="phone" column="phone"/>

    </resultMap>

    <!-- 一覧取得 -->
    <select id="findAll" resultMap="storeResultMap">
        SELECT
            id,
            name,
            name_kana,
            mail,
            password,
            representative,
            is_deleted,
            address,
            description,
            picture_url,
            phone
        FROM "stores"
        WHERE is_deleted = false
        ORDER BY id
    </select>

    <!-- 更新 -->
    <update id="update">
        UPDATE "stores"
        SET
            name = #{name},
            name_kana = #{nameKana},
            mail = #{mail},
            representative = #{representative},
            address = #{address},
            description = #{description},
            picture_url = #{pictureUrl},
            phone = #{phone}
        WHERE id = #{id}
    </update>

    <!-- 論理削除 -->
    <update id="deleteByIds">
        UPDATE "stores"
        SET is_deleted = true
        WHERE id IN
        <foreach item="id"
                 collection="list"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>
    </update>

    <!-- 新規登録 -->
    <insert id="create">
        INSERT INTO "stores" (
            name,
            name_kana,
            mail,
            password,
            representative,
            is_deleted,
            address,
            description,
            picture_url,
            phone
        )
        VALUES (
            #{name},
            #{nameKana},
            #{mail},
            #{password},
            #{representative},
            false,
            #{address},
            #{description},
            #{pictureUrl},
            #{phone}
        )
    </insert>

    <!-- 名前・ふりがな・メールアドレスがすべて一致する店舗を確認 -->
    <select id="existsSameStore" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM "stores"
            WHERE name = #{name}
              AND name_kana = #{nameKana}
              AND mail = #{mail}
        )
    </select>

    <!-- メールアドレス単独の重複を確認 -->
    <select id="existsMail" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM "stores"
            WHERE mail = #{mail}
        )
    </select>

    <!-- 一括更新対象のID群を除外して、同じ店舗が存在するか確認 -->
    <select id="existsSameStoreExcludingIds" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM "stores"
            WHERE name = #{name}
              AND name_kana = #{nameKana}
              AND mail = #{mail}
              AND id NOT IN
              <foreach item="id"
                       collection="excludedIds"
                       open="("
                       separator=","
                       close=")">
                  #{id}
              </foreach>
        )
    </select>

    <!-- 一括更新対象のID群を除外して、メールアドレスが存在するか確認 -->
    <select id="existsMailExcludingIds" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM "stores"
            WHERE mail = #{mail}
              AND id NOT IN
              <foreach item="id"
                       collection="excludedIds"
                       open="("
                       separator=","
                       close=")">
                  #{id}
              </foreach>
        )
    </select>

</mapper>
