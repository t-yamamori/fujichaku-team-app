<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ReviewMapper">

<select id="selectAllReviews" resultType="com.example.demo.entity.Reviews">
  select * from reviews where store_id = #{storeId} order by id desc
</select>
<select id="selectOneReview" resultType="com.example.demo.entity.Reviews">
  select * from reviews where store_id = #{storeId} order by id desc limit 1
</select>
</mapper>

    <insert id="addReview">
        INSERT INTO review (store_id, comment)
        VALUES (#{store_Id}, #{comment})
    </insert>

    <delete id="deleteReview">
        DELETE FROM review
        WHERE id = #{id}
    </delete>


</mapper>